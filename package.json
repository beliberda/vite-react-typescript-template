{
  "name": "vite-typescript-react-template",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "server:dev": "cd server && npm start",
    "electron:dev": "concurrently \"npm run server:dev\" \"npm run dev\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:build": "npm run build && electron-builder",
    "electron:start": "electron .",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "@ruffle-rs/ruffle": "^0.2.0-nightly.2025.12.20"
  },
  "build": {
    "appId": "com.flashgame.launcher",
    "productName": "Flash Game Launcher",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "node_modules/**/*"
    ]
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@typescript-eslint/eslint-plugin": "^7.2.0",
    "@typescript-eslint/parser": "^7.2.0",
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^8.2.2",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.6",
    "globals": "^16.5.0",
    "typescript": "^5.2.2",
    "vite": "^5.2.0",
    "electron": "^9.4.4",
    "electron-builder": "^24.9.1",
    "wait-on": "^7.2.0"
  }
}
